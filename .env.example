# 复制为 .env 后，仅用于本地开发。生产环境请使用独立的密钥管理方式。
MYSQL_DATABASE=lightbite
MYSQL_USER=lightbite
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_PORT=3308

DB_URL=jdbc:mysql://localhost:3308/lightbite?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=lightbite
DB_PASSWORD=replace_with_local_password
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
